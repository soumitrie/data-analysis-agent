AGENT_DATABASE_URL=sqlite:///./data/agent.db

# Ledger Lens uses Google Gemini. Set your key here (auto-detected when the
# provider is left blank):
AGENT_GEMINI_API_KEY=

# Override model (uses the Gemini default `gemini-3.1-pro` when blank):
# AGENT_LLM_MODEL=gemini-3.1-pro

# Optional token cost rates (USD per 1,000 tokens). When both are unset/0,
# estimated_cost_usd is reported as null ("n/a"); token counts are always logged.
# AGENT_LLM_INPUT_COST_PER_1K=0.0
# AGENT_LLM_OUTPUT_COST_PER_1K=0.0

PORT=8001
